{
  "policy_id": "dynamic-signal-policy-v1",
  "status": "adopted_full",
  "adopted_at": "2026-06-05",
  "mode": "collect_only",
  "core_principles": {
    "dynamic_preferences_and_metrics": true,
    "no_hard_fixed_thresholds_except_min_safety": true,
    "market_adaptation_axes": [
      "symbol_profile",
      "daily_range",
      "volume_liquidity",
      "intraday_market_behavior"
    ]
  },
  "decision_framework": {
    "numeric_chart_only": true,
    "multi_timeframe_analysis": true,
    "best_timeframe_selection_per_symbol": true,
    "integrated_modules": [
      "indicators",
      "price_structure",
      "breakout_detection",
      "trend_model",
      "support_resistance",
      "retest_rebound_logic",
      "directional_fibonacci",
      "daily_high_low",
      "session_high_low"
    ],
    "sessions_model": {
      "enabled": true,
      "sessions": ["sydney", "asia", "london", "new_york"],
      "relation_logic": [
        "full_behavior",
        "session_weight",
        "momentum",
        "liquidity"
      ],
      "dynamic_weights_enabled": true
    }
  },
  "adaptive_controls": {
    "adaptive_weights_enabled": true,
    "adaptive_thresholds_enabled": true,
    "adaptation_speed": "per_cycle",
    "anti_overfitting_guard": {
      "enabled": true,
      "method": "smooth_weight_shift",
      "max_weight_step_per_cycle": 0.15
    }
  },
  "economic_calendar": {
    "enabled": true,
    "primary_source": "https://www.arabictrader.com/ar/economic-calendar",
    "secondary_sources": [
      "https://www.forexfactory.com/"
    ],
    "integration_mode": "auto_symbol_relevance",
    "focus": "high_and_medium_impact_first"
  },
  "safety_minimums": {
    "min_rr": 1.2,
    "max_volatility_pct": 6.0,
    "hard_floor_enabled": true
  },
  "goal": "maximize signal safety and precision under dynamic market conditions"
}
